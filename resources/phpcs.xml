<?xml version="1.0"?>
<ruleset name="Talon">
    <description>Talon Coding Standards (PSR-12)</description>

    <!-- Arguments:
         p = Show progress
         s = Show sniff codes in output
         colors = Force color output (optional, often auto-detected)
    -->
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Phalcon"/>
    <file>../bin</file>
    <file>../src</file>
    <file>../tests</file>
    <!-- Mutation runs leave crash debris here that breaks traversal. -->
    <exclude-pattern>*/tests/_output/*</exclude-pattern>
</ruleset>
